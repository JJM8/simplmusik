#!/usr/bin/env python3
"""Build every package, replacing whatever is in build/.

The .deb, the .flatpak and the .apk are three parts of one release, and they
have to be cut from the same checkout or the download buttons in the README
start handing out different apps. This runs the builds back to back so that
can't drift - which matters most for the APK, whose whole design is that there
is no second copy of the app in it.

    ./build-all                  # replace build/*.deb, *.flatpak and *.apk
    ./build-all --version 0.2.0  # ...with a version of your choosing

Every build gets its own number. VERSION in build-deb is the one you are about
to cut; it ticks up by .1 once both packages are built, so no two builds go out
alike. Set that line by hand to move a whole version - 0.2.0 - and the ticking
carries on from there. Naming a version with --version uses it as given and
leaves the counter where it is.
    ./build-all --fresh          # ...fetching yt-dlp again first
    ./build-all --install        # ...and install the flatpak when it's done
    ./build-all --keep           # leave both build trees for a look

The deb goes first because it takes seconds: anything wrong with the checkout
surfaces there rather than twenty minutes into compiling mpv. The APK is
skipped, with a line saying so, on a machine with no Android SDK - it is the
one package that needs a toolchain the others don't, and not having it should
not stop a release of the two that were always there.

    ./build-all --no-apk         # skip it even where it would have worked

Once everything is built, the packages replace the ones on the latest GitHub
release under the names without a version in them - simplmusik.flatpak,
simplmusik_all.deb, simplmusik.apk - which are the files the README's download
buttons point at. So a build here is what the next person to press one gets.
`./build-apk` on its own never does this: it is for putting a build on your own
phone, not for handing one out.

    ./build-all --no-publish     # build, but leave the release alone

Publishing needs the GitHub CLI, logged in (`gh auth login`). Without it the
builds are kept and a line says nothing was uploaded.

Use --fresh when cutting a release. The yt-dlp in build/yt-dlp.cache is reused
between builds, which is what you want while working and not what you want in
something you hand out - YouTube retires extractors within months, and a
package is only as current as the copy frozen into it.

Needs whatever the builds need: dpkg-deb for one, flatpak and flatpak-builder
for another, a JDK and an Android SDK for the third. Each says so itself if
it's missing.
"""

import importlib.machinery, importlib.util, os, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
BUILD = os.path.join(HERE, "build")
CACHE = os.path.join(BUILD, "yt-dlp.cache")


def load(filename, modname):
    """Import a sibling script. None of them end in .py, so they are loaded by
    path rather than found on sys.path."""
    path = os.path.join(HERE, filename)
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def run(script, args, label):
    """One of the two builds, with its output left alone so its own progress
    still reads the way it does when run directly."""
    print("\n=== %s ===\n" % label, flush=True)
    started = time.time()
    r = subprocess.run([sys.executable, os.path.join(HERE, script)] + args,
                       cwd=HERE)
    if r.returncode != 0:
        sys.exit("\n%s failed - nothing else was built." % script)
    return time.time() - started


def main():
    args = sys.argv[1:]
    deb = load("build-deb", "simplmusik_build_all_version")
    version, pinned = deb.VERSION, "--version" in args
    if pinned:
        i = args.index("--version")
        if i + 1 >= len(args):
            sys.exit("--version needs a number, e.g. --version 0.2.0")
        version = args[i + 1]

    # Both builds take these and mean the same thing by them. --install and
    # --fresh are this script's own: only the flatpak knows how to install
    # itself, and the cache is shared, so dropping it here does both.
    passthrough = ["--version", version]
    if "--keep" in args:
        passthrough.append("--keep")

    if "--fresh" in args and os.path.isfile(CACHE):
        os.remove(CACHE)
        print("dropped the cached yt-dlp - it will be fetched again")

    deb_args = list(passthrough)
    flatpak_args = list(passthrough)
    if "--install" in args:
        flatpak_args.append("--install")
    if "--fresh" in args:
        flatpak_args.append("--fresh")      # the flatpak pins yt-dlp in its manifest

    # The APK needs an SDK the other two don't, so whether it is being built
    # is settled - and said - before anything starts, rather than surfacing as
    # a failure at the end of a long run.
    apk = "--no-apk" not in args and have_sdk()
    print("building simplmusik %s - %s" % (version, "all three packages" if apk
                                           else "the deb and the flatpak"))
    if not apk and "--no-apk" not in args:
        print("  (no Android SDK found, so no APK - set ANDROID_HOME to get one)")
    took = run("build-deb", deb_args, "the Debian package")
    took += run("build-flatpak", flatpak_args, "the flatpak")
    if apk:
        # Only the version: --keep is about build trees the other two leave
        # behind, and Gradle keeps its own either way.
        took += run("build-apk", ["--version", version], "the Android package")

    # Both packages are built, so this number is spent: tick it over so the
    # next build is a new version rather than a second copy of this one. A
    # version asked for by hand is yours and is left alone.
    if not pinned:
        print("next build will be %s" % deb.bump())

    print("\n=== done in %s ===\n" % human(took))
    built = {}
    for name, button in (("simplmusik_%s_all.deb" % version, "simplmusik_all.deb"),
                         ("simplmusik_%s.flatpak" % version, "simplmusik.flatpak"),
                         ("simplmusik_%s.apk" % version, "simplmusik.apk")):
        p = os.path.join(BUILD, name)
        if os.path.isfile(p):
            print("  build/%-32s %6.1f MB" % (name, os.path.getsize(p) / 1e6))
            built[button] = p

    if "--no-publish" not in args:
        publish(built)


def publish(built):
    """Replace the files the README's download buttons point at.

    The buttons link to releases/latest/download/<name>, so the name has to
    stay the same from one build to the next - the version is in the release,
    not the filename. Staged as copies under those names because an upload is
    named after the file it reads."""
    if not built:
        return
    if not shutil.which("gh"):
        print("\nno GitHub CLI (gh), so the release was left alone")
        return
    r = subprocess.run(["gh", "release", "view", "--json", "tagName", "--jq", ".tagName"],
                       cwd=HERE, capture_output=True, text=True)
    tag = r.stdout.strip()
    if r.returncode or not tag:
        print("\ncouldn't find a latest release to update, so nothing was uploaded:\n  %s"
              % (r.stderr.strip() or "no releases yet - make one with `gh release create`"))
        return
    dirty = subprocess.run(["git", "status", "--porcelain", "--untracked-files=no"],
                           cwd=HERE, capture_output=True, text=True).stdout.strip()
    if dirty:
        print("\nnote: there are uncommitted changes - this build includes them")

    stage = os.path.join(BUILD, "release")
    shutil.rmtree(stage, ignore_errors=True)
    os.makedirs(stage)
    files = []
    for button, src in built.items():
        dst = os.path.join(stage, button)
        shutil.copyfile(src, dst)
        files.append(dst)

    print("\n=== uploading to release %s ===\n" % tag, flush=True)
    r = subprocess.run(["gh", "release", "upload", tag, "--clobber"] + files, cwd=HERE)
    if r.returncode:
        print("\nthe upload failed - the builds are still in build/")
        return
    for button in built:
        print("  %s" % button)


def have_sdk():
    """Whether there is an Android SDK to build the APK with."""
    return any(os.path.isdir(d) for d in
               [os.environ.get("ANDROID_HOME") or "",
                os.environ.get("ANDROID_SDK_ROOT") or "",
                os.path.expanduser("~/Android/Sdk")])


def human(seconds):
    m, s = divmod(int(seconds), 60)
    return "%dm %ds" % (m, s) if m else "%ds" % s


if __name__ == "__main__":
    main()
