#!/usr/bin/env python3
"""One-shot upgrade from the folder-per-playlist layout.

Before: ~/Music/<playlist>/ held a playlist.json and that playlist's songs.
After:  the songs stay exactly where they are - your music folder is walked
        all the way down now, so a folder per playlist is just a folder - and
        the list itself moves to .simplmusik/playlists/<name>.json inside
        your music folder, naming each song by filename and the folder it
        sits in.

Nothing is copied, moved or deleted except the old playlist.json files, which
have been read by then. Run it twice and the second run finds nothing to do.
Pass --dry-run to see what it would do first.
"""

import importlib.machinery, importlib.util, json, os, sys

AUDIO = {".mp3", ".wav", ".flac", ".ogg", ".m4a", ".opus", ".aac"}
ROOT = os.path.expanduser("~/Music")
DRY = "--dry-run" in sys.argv

def cli():
    """Import the CLI, so where playlists go is its answer and not a second
    copy of it here."""
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader("sm", os.path.join(here, "simplmusik"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod

PLAYLISTS = cli().playlists_dir()

def old_playlists():
    """The folders still in the old layout, as (folder, playlist.json)."""
    for name in sorted(os.listdir(ROOT)) if os.path.isdir(ROOT) else []:
        d = os.path.join(ROOT, name)
        j = os.path.join(d, "playlist.json")
        if os.path.isdir(d) and os.path.isfile(j):
            yield name, d, j

def main():
    folders = list(old_playlists())
    if not folders:
        return print("nothing in the old layout - nothing to do")

    for name, d, jpath in folders:
        try:
            with open(jpath) as f:
                m = json.load(f)
        except (OSError, ValueError):
            m = {}

        # The old format let `songs` be absent, meaning "scan the folder".
        listed = m.get("songs")
        names = ([os.path.basename(s) for s in listed
                  if s and os.path.isfile(os.path.join(d, os.path.basename(s)))]
                 if isinstance(listed, list) else
                 sorted(f for f in os.listdir(d)
                        if os.path.splitext(f)[1].lower() in AUDIO))

        out = {"name": m.get("name", name),
               "songs": [{"file": s, "dir": d} for s in names]}
        if m.get("cover"):
            out["cover"] = os.path.basename(m["cover"])
        print("%-30s %d song%s -> playlists/%s.json"
              % (name, len(names), "" if len(names) == 1 else "s", name))
        if DRY:
            continue
        os.makedirs(PLAYLISTS, exist_ok=True)
        with open(os.path.join(PLAYLISTS, name + ".json"), "w") as f:
            json.dump(out, f, indent=2)
        os.remove(jpath)            # read, and written out somewhere better

    print("\n%s" % ("dry run: nothing changed" if DRY else
                    "done - your songs never moved, only the lists did"))

if __name__ == "__main__":
    main()
