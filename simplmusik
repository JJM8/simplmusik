    ("seek",    "jump within the song (1:23, 83, +30, -10)",      "time",            None),
    ("stop",    "stop playback",                                  "",                None),
    ("update",  "fetch the newest yt-dlp, which YouTube keeps needing", "",       None),
    ("help",    "show this help, or help for one command",        "topic?",          None),
]

CMDS = {"status": cmd_status, "songs": cmd_songs, "list": cmd_list,
        "folder": cmd_folder, "levelling": cmd_levelling, "volume": cmd_volume,
        "target": cmd_target,
        "create": cmd_create, "add": cmd_add, "remove": cmd_remove,
        "rename": cmd_rename, "cover": cmd_cover,
        "search": cmd_search, "download": cmd_download, "stream": cmd_stream,
        "delete": cmd_delete, "play": cmd_play, "shuffle": cmd_shuffle,
        "seek": cmd_seek, "stop": cmd_stop, "pause": cmd_pause,
        "resume": lambda args: cmd_pause(args, want=False),
        "skip": lambda args: cmd_move(args, "skip"),
        "back": lambda args: cmd_move(args, "back"),
        "update": cmd_update}

def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["_player"]:         # internal: the detached player process
        job = load_json(argv[1], None)  # cmd_play left this for us, and for no
        try:                            # one else, so it goes as soon as it is
            os.remove(argv[1])          # read - nothing stale is left behind
        except OSError:
            pass
        if not job:                 # no queue to run: nothing to play
            return 1
        return player(job) or 0
    if argv[:1] == ["_fetch"]:          # internal: the detached download that
        return fetch(argv[1], argv[2])  # runs behind a song being streamed
    migrate()                           # playlists moved folder once, long ago
    ap = argparse.ArgumentParser(prog="simplmusik", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name, help_, positional, flag in COMMANDS:
        p = sub.add_parser(name, help=help_)
        for spec in positional.split():
            p.add_argument(spec.rstrip("?+"),
                           nargs={"?": "?", "+": "+"}.get(spec[-1]))
        if flag == "cover":
            p.add_argument("--cover", help="an image to use as its cover art")
        elif flag == "clear":
            p.add_argument("--clear", action="store_true",
                           help="take the cover art off again")
        elif flag == "shuffle":
            p.add_argument("--shuffle", action="store_true",
                           help="turn shuffle on, and play shuffled")
        elif flag == "count":
            p.add_argument("--count", type=int, default=SEARCH_N,
                           help="how many results to bring back (up to %d)" % SEARCH_MAX)

    args = ap.parse_args(argv)
    if args.cmd == "help":
        if not args.topic:
            return ap.print_help() or 0
        if args.topic not in sub.choices:
            print("no such command: " + args.topic, file=sys.stderr)
            return 1
        return sub.choices[args.topic].print_help() or 0
    return CMDS[args.cmd](args)

if __name__ == "__main__":
    sys.exit(main())
