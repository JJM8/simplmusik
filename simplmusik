    ("folder",  "show your music folder, or choose another",      "action? path?",   None),
    ("songs",   "list every song in the library",                 "",                None),
    ("list",    "list playlists, or the songs in one",            "playlist?",       None),
    ("create",  "make a new, empty playlist",                     "name",            "cover"),
    ("rename",  "give a playlist a different name",               "playlist name",   None),
    ("cover",   "show, set or clear a playlist's cover art",      "playlist image?", "clear"),
    ("add",     "add songs to a playlist, importing new ones",    "playlist files+", None),
    ("search",  "search YouTube for songs",                       "query+",          "count"),
    ("download","download a search result into the library",      "id",              None),
    ("stream",  "play a search result now, and fetch it as it plays", "id",          None),
    ("remove",  "drop a song from a playlist, or delete it",      "playlist song?",  None),
