#!/usr/bin/env python3
"""Build a .flatpak of simplmusik.

One file that installs on any distro with flatpak, because everything it needs
- mpv, WebKit, ffmpeg, Python - is inside it rather than borrowed from your
package manager. That is the whole reason this exists next to the .deb.

The manifest is io.github.JJM8.simplmusik.yml and it does all the work: every
file in the app is listed there, from this repository or by URL and checksum,
which is the same manifest Flathub builds from. This script only runs it and
packs the result into one file you can hand to someone.

    ./build-flatpak                  # build simplmusik_<version>.flatpak
    ./build-flatpak --version 0.2.0  # ...with a version of your choosing
    ./build-flatpak --fresh          # ...moving yt-dlp to its newest release
    ./build-flatpak --install        # ...and install it when it's done
    ./build-flatpak --keep           # leave the build tree for a look

The version being built gets a <release> in the metainfo if it has none yet,
written into the file in this folder rather than a copy, so it is there to be
committed for Flathub. --fresh likewise rewrites the manifest's yt-dlp URL and
checksum in place.

Needs flatpak, and flatpak-builder either on the PATH or installed as
org.flatpak.Builder - the build prints the command to get what's missing.
"""

import hashlib, importlib.machinery, importlib.util, json, os, re, shutil, subprocess, sys
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
BUILD = os.path.join(HERE, "build")
TREE = os.path.join(BUILD, "flatpak-build")     # flatpak-builder's workspace
REPO = os.path.join(BUILD, "flatpak-repo")      # the one-app repo it exports to

APP_ID = "io.github.JJM8.simplmusik"
MANIFEST = os.path.join(HERE, APP_ID + ".yml")
RUNTIME, RUNTIME_VERSION = "org.gnome.Platform", "50"
SDK = "org.gnome.Sdk"


def load(filename, modname):
    """Import one of the sibling scripts. None of them end in .py, so they are
    loaded by path rather than found on sys.path."""
    path = os.path.join(HERE, filename)
    loader = importlib.machinery.SourceFileLoader(modname, path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def builder():
    """flatpak-builder, however this machine happens to have it.

    It ships as a flatpak itself now, so the packaged command is the more
    likely of the two to be there."""
    if shutil.which("flatpak-builder"):
        return ["flatpak-builder"]
    if subprocess.run(["flatpak", "info", "org.flatpak.Builder"],
                      capture_output=True).returncode == 0:
        return ["flatpak", "run", "org.flatpak.Builder"]
    sys.exit("flatpak-builder isn't installed - get it with:\n"
             "    flatpak install -y flathub org.flatpak.Builder")


def check_runtime():
    """The runtime and the SDK, or the line that installs them."""
    missing = [r for r in ("%s//%s" % (RUNTIME, RUNTIME_VERSION),
                           "%s//%s" % (SDK, RUNTIME_VERSION))
               if subprocess.run(["flatpak", "info", r],
                                 capture_output=True).returncode != 0]
    if missing:
        sys.exit("missing flatpak runtime%s - get %s with:\n    flatpak "
                 "install -y flathub %s"
                 % ("" if len(missing) == 1 else "s",
                    "it" if len(missing) == 1 else "them", " ".join(missing)))


def fresh_ytdlp():
    """Point the manifest at the newest yt-dlp release, checksum and all.

    The checksum is worked out from the file itself rather than taken from
    the release page, so what goes in the manifest is what was downloaded."""
    print("  checking for a newer yt-dlp ...", end=" ", flush=True)
    try:
        with urllib.request.urlopen(
                "https://api.github.com/repos/yt-dlp/yt-dlp/releases/latest",
                timeout=30) as r:
            tag = json.load(r)["tag_name"]
        url = "https://github.com/yt-dlp/yt-dlp/releases/download/%s/yt-dlp" % tag
        with urllib.request.urlopen(url, timeout=180) as r:
            sha = hashlib.sha256(r.read()).hexdigest()
    except Exception as e:
        sys.exit("\ncouldn't check yt-dlp: %s" % e)
    with open(MANIFEST) as f:
        text = f.read()
    new = re.sub(r"url: https://github.com/yt-dlp/yt-dlp/releases/download/\S+/yt-dlp\n"
                 r"(\s*)sha256: [0-9a-f]{64}",
                 lambda m: "url: %s\n%ssha256: %s" % (url, m.group(1), sha), text)
    if new == text and url not in text:
        sys.exit("\ncouldn't find the yt-dlp source in %s" % MANIFEST)
    with open(MANIFEST, "w") as f:
        f.write(new)
    print(tag)


def note_release(version):
    """Give the metainfo a <release> for this version if it hasn't one."""
    deb = load("build-deb", "simplmusik_build_deb")
    text = deb.metainfo(version)
    with open(deb.METAINFO) as f:
        if f.read() == text:
            return
    with open(deb.METAINFO, "w") as f:
        f.write(text)
    print("  added release %s to the metainfo" % version)


def main():
    args = sys.argv[1:]
    deb = load("build-deb", "simplmusik_build_deb_version")
    version = deb.VERSION                       # one version, kept in build-deb
    if "--version" in args:
        i = args.index("--version")
        if i + 1 >= len(args):
            sys.exit("--version needs a number, e.g. --version 0.2.0")
        version = args[i + 1]
    if not shutil.which("flatpak"):
        sys.exit("flatpak isn't installed - `sudo apt install flatpak`")
    build = builder()
    check_runtime()

    print("building %s %s" % (APP_ID, version))
    if "--fresh" in args:
        fresh_ytdlp()
    note_release(version)

    print("  building the flatpak (mpv is compiled here - give it a while)")
    subprocess.run(build + ["--force-clean", "--disable-rofiles-fuse",
                            "--repo=" + REPO, TREE, MANIFEST],
                   check=True, cwd=HERE)

    out = os.path.join(BUILD, "simplmusik_%s.flatpak" % version)
    subprocess.run(["flatpak", "build-bundle", REPO, out, APP_ID,
                    "--runtime-repo=https://dl.flathub.org/repo/flathub.flatpakrepo"],
                   check=True)
    if "--keep" not in args:
        shutil.rmtree(TREE, ignore_errors=True)

    print("\n%s  (%.1f MB)" % (out, os.path.getsize(out) / 1e6))
    if "--install" in args:
        subprocess.run(["flatpak", "install", "--user", "-y", out], check=True)
        print("\nInstalled. Press Super, type music.")
    else:
        print("\nInstall it with:\n    flatpak install --user %s" % out)


if __name__ == "__main__":
    main()
